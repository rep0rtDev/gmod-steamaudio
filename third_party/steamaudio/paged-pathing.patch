+void PathFinder::buildProbePath(int start, int end, int threadIndex, ProbePath& path) const
+{
+    path.reset();
+    path.start = start;
+    path.end = end;
+    auto parent = mParents[threadIndex][end];
+    if (parent < 0)
+        return;
+    path.valid = true;
+    int steps = 0;
+    while (parent >= 0 && parent != start && steps++ < mParents.size(1))
+    {
+        path.nodes.push_back(parent);
+        parent = mParents[threadIndex][parent];
     }
+    if (parent != start)
+    {
+        path.reset();
+        return;
+    }
+    std::reverse(path.nodes.begin(), path.nodes.end());
