+namespace {
+const ipl::BakedPathData* FilePathData(void* handle)
+{
+    if (!handle) return nullptr;
+    auto batch = reinterpret_cast<api::CProbeBatch*>(handle)->mHandle.get();
+    if (!batch) return nullptr;
+    ipl::BakedDataIdentifier id;
+    id.type = ipl::BakedDataType::Pathing;
+    id.variation = ipl::BakedDataVariation::Dynamic;
+    return batch->hasData(id) ? &static_cast<const ipl::BakedPathData&>((*batch)[id]) : nullptr;
+}
+}
+
+extern "C" {
+IPLAPI uint32_t SA_PATHCALL saPathCacheVersion() { return 1; }
+
+IPLAPI int32_t SA_PATHCALL saPathCacheConfigure(const char* directory, const char* output, uint64_t key, uint64_t cacheBytes)
+{
+    if (!directory || cacheBytes < 4ull * 1024 * 1024 || cacheBytes > 1024ull * 1024 * 1024) return 1;
+    try {
+        ipl::PathBaker::FileCacheSettings settings;
+        settings.directory = directory;
+        settings.output = output ? output : "";
+        settings.key = key;
+        settings.cacheBytes = cacheBytes;
+        ipl::PathBaker::configureFileCache(settings);
+        return 0;
+    } catch (...) { return 1; }
+}
+
+IPLAPI int32_t SA_PATHCALL saPathCacheLookup(void* batch, int32_t start, int32_t end, sa::PathCacheRecord* out)
+{
+    if (!out) return 0;
+    try {
+        const auto* data = FilePathData(batch);
+        if (!data) return 0;
+        const auto path = data->lookupShortestPath(start, end, nullptr);
+        if (!path.isValid()) return 0;
+        *out = sa::PathCacheRecord{};
+        out->target = static_cast<uint16_t>(end);
+        out->first = path.firstProbe;
+        out->last = path.lastProbe;
+        out->afterFirst = path.probeAfterFirst;
+        out->beforeLast = path.probeBeforeLast;
+        out->flags = path.direct ? 1 : 0;
+        out->distance = path.distanceInternal;
+        out->deviation = path.deviationInternal;
+        return 1;
+    } catch (...) { return 0; }
+}
+
+IPLAPI int32_t SA_PATHCALL saPathCacheStats(void* batch, sa::PathCacheApiStats* out)
+{
+    if (!out) return 0;
+    try {
+        const auto* data = FilePathData(batch);
+        if (!data) return 0;
+        const auto stats = data->fileCacheStats();
+        *out = sa::PathCacheApiStats{};
+        out->probes = stats.probes;
+        out->completedRows = stats.completedRows;
+        out->complete = stats.complete ? 1 : 0;
+        out->residentBytes = stats.residentBytes;
+        out->diskBytes = stats.diskBytes;
+        out->pageReads = stats.pageReads;
+        return 1;
+    } catch (...) { return 0; }
+}
+
+IPLAPI int32_t SA_PATHCALL saPathCacheReadProbes(void* handle, uint32_t capacity, sa::PathCacheProbe* output)
+{
+    if (!handle) return 0;
+    try {
+        const auto batch = reinterpret_cast<api::CProbeBatch*>(handle)->mHandle.get();
+        if (!batch || batch->numProbes() <= 0 || batch->numProbes() > 32768) return 0;
+        const int count = batch->numProbes();
+        if (!output) return count;
+        if (capacity < static_cast<uint32_t>(count)) return 0;
+        for (int i = 0; i < count; ++i) {
+            const auto& p = (*batch)[i].influence;
+            output[i] = sa::PathCacheProbe{p.center[0], p.center[1], p.center[2], p.radius};
+        }
+        return count;
+    } catch (...) { return 0; }
+}
+
+IPLAPI int32_t SA_PATHCALL saPathCacheAttach(void* destination, void* source)
+{
+    if (!destination || !source || destination == source) return 0;
+    try {
+        auto target = reinterpret_cast<api::CProbeBatch*>(destination)->mHandle.get();
+        auto input = reinterpret_cast<api::CProbeBatch*>(source)->mHandle.get();
+        if (!target || !input || target->numProbes() != input->numProbes()) return 0;
+        for (int i = 0; i < target->numProbes(); ++i) {
+            const auto& a = (*target)[i].influence;
+            const auto& b = (*input)[i].influence;
+            if (a.radius != b.radius || a.center[0] != b.center[0] || a.center[1] != b.center[1] || a.center[2] != b.center[2])
+                return 0;
+        }
+        ipl::BakedDataIdentifier id;
+        id.type = ipl::BakedDataType::Pathing;
+        id.variation = ipl::BakedDataVariation::Dynamic;
+        auto& data = input->getData();
+        auto entry = data.find(id);
+        if (entry == data.end() || !static_cast<ipl::BakedPathData*>(entry->second.get())->complete()) return 0;
+        target->addData(id, std::move(entry->second));
+        data.erase(entry);
+        return 1;
+    } catch (...) { return 0; }
+}
+
+IPLAPI const char* SA_PATHCALL saPathCacheError()
+{
+    static thread_local std::string error;
+    error = ipl::PathBaker::fileCacheError();
+    return error.c_str();
+}
+}
