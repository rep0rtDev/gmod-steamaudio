+void BakedPathData::bakeFilePaths(const IScene& scene, const ProbeBatch& probes, float pathRange, int numThreads,
+                                  ThreadPool& threadPool, std::atomic<bool>& cancel,
+                                  ProgressCallback callback, void* userData)
+{
+    const auto settings = PathBaker::fileCacheSettings();
+    const auto slash = settings.output.find_last_of("/\\");
+    mFileBase = settings.output.substr(slash == std::string::npos ? 0 : slash + 1);
+    mFileKey = settings.key;
+    std::string error;
+    if (!mFilePaths->Begin(settings.output, probes.numProbes(), settings.key, settings.cacheBytes, error))
+    {
+        PathBaker::setFileCacheError(error);
+        return;
+    }
+    PathFinder finder(probes, numThreads);
+    std::vector<ProbePath> paths(numThreads);
+    std::vector<std::vector<sa::PathCacheRecord>> records(numThreads);
+    for (int i = 0; i < numThreads; ++i)
+    {
+        paths[i].nodes.reserve(probes.numProbes());
+        records[i].reserve(probes.numProbes());
+    }
+    std::atomic<bool> failed(false);
+    JobGraph jobs;
+    for (int row = 0; row < probes.numProbes(); ++row)
+    {
+        jobs.addJob([&, row](int threadIndex, std::atomic<bool>&)
+        {
+            if (cancel || failed || mFilePaths->HasRow(row))
+                return;
+            try
+            {
+                finder.buildShortestPathTree(probes, *mVisGraph, row, pathRange, threadIndex);
+                auto& output = records[threadIndex];
+                output.clear();
+                for (int target = 0; target < row && !cancel && !failed; ++target)
+                {
+                    auto& path = paths[threadIndex];
+                    finder.buildProbePath(row, target, threadIndex, path);
+                    if (!path.valid)
+                        continue;
+                    SoundPath soundPath(path, probes);
+                    sa::PathCacheRecord record;
+                    record.target = static_cast<uint16_t>(target);
+                    record.first = soundPath.firstProbe;
+                    record.last = soundPath.lastProbe;
+                    record.afterFirst = soundPath.probeAfterFirst;
+                    record.beforeLast = soundPath.probeBeforeLast;
+                    record.flags = soundPath.direct ? 1 : 0;
+                    record.distance = soundPath.distanceInternal;
+                    record.deviation = soundPath.deviationInternal;
+                    output.push_back(record);
+                }
+                std::string writeError;
+                if (!cancel && !failed && !mFilePaths->WriteRow(row, output, writeError))
+                {
+                    failed = true;
+                    PathBaker::setFileCacheError(writeError);
+                }
+            }
+            catch (const std::exception& failure)
+            {
+                failed = true;
+                PathBaker::setFileCacheError(failure.what());
+            }
+        });
+    }
+    threadPool.process(jobs, [callback, userData](float progress) { if (callback) callback(progress, userData); });
+    if (!cancel && !failed && !mFilePaths->Finish(error))
+        PathBaker::setFileCacheError(error);
+}
+
+sa::PathCacheFileStats BakedPathData::fileCacheStats() const
+{
+    sa::PathCacheFileStats stats;
+    if (mFilePaths)
+        stats = mFilePaths->Stats();
+    else
+        stats.residentBytes = mBakedPathRefs.totalSize() * sizeof(SoundPathRef) + mUniqueBakedPaths.totalSize() * sizeof(SoundPath);
+    if (mVisGraph)
+        for (const auto& row : mVisGraph->mAdjacent)
+            stats.residentBytes += row.capacity() * sizeof(ProbeVisibilityGraph::AdjacencyListEntry);
+    stats.probes = mNumProbes;
+    return stats;
+}
